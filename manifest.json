{
  "manifest_version": 3,
  "name": "GitHub Helper",
  "version": "0.1.1",
  "description": "A grab bag of small quality-of-life tweaks for github.com.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/features/my-open-prs.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "github-helper@jakedemian.dev",
      "strict_min_version": "109.0"
    }
  }
}
